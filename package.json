{
	"name": "iobroker.mx400",
	"version": "0.0.1",
	"description": "ioBroker adapter for Buderus MX400 (K40 RF gateway) to control and monitor heating system",
	"author": {
		"name": "gauda",
		"email": "info@gauda.de"
	},
	"homepage": "https://github.com/gauda/ioBroker.mx400",
	"license": "MIT",
	"keywords": [
		"iobroker",
		"adapter",
		"mx400",
		"k40",
		"buderus",
		"bosch",
		"heating",
		"heat pump"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/gauda/ioBroker.mx400"
	},
	"engines": {
		"node": ">= 18"
	},
	"main": "build/main.js",
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"watch": "tsc -p tsconfig.build.json --watch",
		"prebuild": "rimraf ./build",
		"lint": "eslint src/**/*.ts",
		"format": "prettier --write src/**/*.ts",
		"test": "node --test test/*.js",
		"release": "release-script"
	},
	"dependencies": {
		"@iobroker/adapter-core": "^3.2.2",
		"axios": "^1.7.9",
		"multicast-dns": "^7.2.5"
	},
	"devDependencies": {
		"@iobroker/adapter-dev": "^1.3.0",
		"@iobroker/eslint-config": "^1.0.0",
		"@iobroker/testing": "^5.0.0",
		"@types/multicast-dns": "^7.2.4",
		"@types/node": "^22.10.2",
		"prettier": "^3.4.2",
		"rimraf": "^6.0.1",
		"typescript": "~5.7.2"
	}
}
